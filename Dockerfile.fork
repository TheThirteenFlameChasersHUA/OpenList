# syntax=docker/dockerfile:1.7

# Builds the OpenList backend together with the forked frontend. The frontend
# is cloned at a tag so the image can be reproduced without a local checkout.
ARG NODE_IMAGE=node:22-bookworm-slim
ARG GO_IMAGE=golang:1.27.3-bookworm
ARG ALPINE_IMAGE=alpine:3.22
ARG FRONTEND_REPO=https://github.com/TheThirteenFlameChasersHUA/OpenList-Frontend.git
ARG FRONTEND_REF=home-background-v1

FROM ${NODE_IMAGE} AS frontend
ARG FRONTEND_REPO
ARG FRONTEND_REF
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch "${FRONTEND_REF}" "${FRONTEND_REPO}" /frontend
WORKDIR /frontend
RUN corepack enable \
    && corepack prepare pnpm@11.28.3 --activate \
    && pnpm install --frozen-lockfile \
    && pnpm build

FROM ${GO_IMAGE} AS backend
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=frontend /frontend/dist ./public/dist
ARG VERSION=dev
ARG WEB_VERSION=home-background
ARG GIT_COMMIT=unknown
RUN CGO_ENABLED=0 go build \
    -trimpath \
    -tags=jsoniter \
    -ldflags="-s -w -X github.com/OpenListTeam/OpenList/v4/internal/conf.Version=${VERSION} -X github.com/OpenListTeam/OpenList/v4/internal/conf.WebVersion=${WEB_VERSION} -X github.com/OpenListTeam/OpenList/v4/internal/conf.GitCommit=${GIT_COMMIT}" \
    -o /out/openlist .

FROM ${ALPINE_IMAGE}
ARG USER=openlist
ARG UID=1001
ARG GID=1001
ARG INSTALL_EXTRAS=false
RUN apk add --no-cache ca-certificates tzdata \
    && if [ "${INSTALL_EXTRAS}" = "true" ]; then \
         apk add --no-cache ffmpeg aria2; \
       fi \
    && addgroup -g "${GID}" "${USER}" \
    && adduser -D -u "${UID}" -G "${USER}" "${USER}" \
    && mkdir -p /opt/openlist/data \
    && chown -R "${UID}:${GID}" /opt/openlist

WORKDIR /opt/openlist
COPY --from=backend --chmod=755 /out/openlist ./openlist
COPY --chmod=755 docker/entrypoint.sh /entrypoint.sh

USER ${USER}
ENV UMASK=022 \
    TZ=Asia/Shanghai
VOLUME ["/opt/openlist/data"]
EXPOSE 5244 5245
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:5244/api/public/settings || exit 1
ENTRYPOINT ["/entrypoint.sh"]
